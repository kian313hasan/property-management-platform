generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  PROPERTY_MANAGER
  ACCOUNTANT
  MAINTENANCE_MANAGER
  STAFF
  TENANT
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
  MIXED
  OTHER
}

enum UnitStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  INACTIVE
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PermissionKey {
  ORGANIZATION_READ
  ORGANIZATION_MANAGE
  USERS_READ
  USERS_MANAGE
  PROPERTIES_READ
  PROPERTIES_MANAGE
  FINANCE_READ
  FINANCE_MANAGE
  MAINTENANCE_READ
  MAINTENANCE_MANAGE
  REPORTS_READ
  AUDIT_READ
  FILES_MANAGE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String
  role          Role      @default(STAFF)
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  managedProperties Property[] @relation("PropertyManager")
  maintenanceRequests MaintenanceRequest[] @relation("AssignedMaintenance")
  memberships OrganizationMember[]
  auditLogs AuditLog[] @relation("AuditActor")
}

model Property {
  id          String         @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name        String
  address     String
  city        String
  country     String
  type        PropertyType   @default(RESIDENTIAL)
  status      PropertyStatus @default(ACTIVE)
  managerId   String?
  manager     User?          @relation("PropertyManager", fields: [managerId], references: [id], onDelete: SetNull)
  units       Unit[]
  expenses    Expense[]
  maintenanceRequests MaintenanceRequest[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([organizationId])
  @@unique([id, organizationId])
  @@index([managerId])
  @@index([status])
}

model Unit {
  id          String     @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId  String
  unitNumber  String
  floor       Int?
  bedrooms    Int?
  bathrooms   Float?
  area        Float?
  rentAmount     Decimal  @db.Decimal(18, 2)
  status      UnitStatus @default(AVAILABLE)
  property    Property   @relation(fields: [propertyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  leases      Lease[]
  expenses    Expense[]
  maintenanceRequests MaintenanceRequest[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([propertyId, unitNumber])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([status])
}

model Tenant {
  id          String   @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name        String
  email       String?
  phone       String?
  nationalId  String?
  address     String?
  leases      Lease[]
  maintenanceRequests MaintenanceRequest[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId])
  @@unique([id, organizationId])
  @@index([email])
}

model Lease {
  id            String      @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unitId        String
  tenantId      String
  startDate     DateTime
  endDate       DateTime
  rentAmount     Decimal  @db.Decimal(18, 2)
  depositAmount Decimal? @db.Decimal(18, 2)
  paymentDueDay Int         @default(1)
  status        LeaseStatus @default(DRAFT)
  notes         String?
  unit          Unit        @relation(fields: [unitId, organizationId], references: [id, organizationId], onDelete: Cascade)
  tenant        Tenant      @relation(fields: [tenantId, organizationId], references: [id, organizationId], onDelete: Cascade)
  payments      Payment[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([organizationId])
  @@unique([id, organizationId])
  @@index([unitId])
  @@index([tenantId])
  @@index([status])
}

model Payment {
  id          String        @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaseId     String
  amount      Decimal  @db.Decimal(18, 2)
  dueDate     DateTime
  paidDate    DateTime?
  status      PaymentStatus @default(PENDING)
  method      String?
  reference   String?
  notes       String?
  lease       Lease         @relation(fields: [leaseId, organizationId], references: [id, organizationId], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([organizationId])
  @@unique([id, organizationId])
  @@index([leaseId])
  @@index([status])
  @@index([dueDate])
}

model Expense {
  id         String   @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId String
  unitId     String?
  category   String
  amount      Decimal  @db.Decimal(18, 2)
  date       DateTime
  vendor     String?
  notes      String?
  property   Property @relation(fields: [propertyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  unit       Unit?    @relation(fields: [unitId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([organizationId])
  @@unique([id, organizationId])
  @@index([propertyId])
  @@index([unitId])
  @@index([date])
}

model MaintenanceRequest {
  id          String   @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId  String
  unitId      String?
  tenantId    String?
  assignedToId String?
  title       String
  description String?
  priority    String   @default("MEDIUM")
  status      String   @default("OPEN")
  cost        Decimal? @db.Decimal(18, 2)
  openedAt    DateTime @default(now())
  resolvedAt  DateTime?
  property    Property @relation(fields: [propertyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  unit        Unit?    @relation(fields: [unitId, organizationId], references: [id, organizationId], onDelete: Restrict)
  tenant      Tenant?  @relation(fields: [tenantId, organizationId], references: [id, organizationId], onDelete: Restrict)
  assignedTo  User?    @relation("AssignedMaintenance", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([propertyId])
  @@index([unitId])
  @@index([tenantId])
  @@index([organizationId])
  @@index([assignedToId])
  @@index([status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}


model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members   OrganizationMember[]
  auditLogs AuditLog[]
  properties Property[]
  units Unit[]
  tenants Tenant[]
  leases Lease[]
  payments Payment[]
  expenses Expense[]
  maintenanceRequests MaintenanceRequest[]
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           Role         @default(STAFF)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
}

model Permission {
  id          String       @id @default(cuid())
  key         PermissionKey @unique
  description String?
  roleLinks   RolePermission[]
}

model RolePermission {
  role         Role
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([role, permissionId])
  @@index([permissionId])
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  actorUserId    String?
  action         String
  resourceType   String?
  resourceId     String?
  requestId      String
  metadata       Json?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor          User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
  @@index([requestId])
}
